rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares de autorização
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      return request.auth.token.role != null ? request.auth.token.role : 
        (exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) ? 
          get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role : 'none');
    }
    
    function isAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || getUserRole() == 'admin');
    }
    
    function hasEntitlement(minRole) {
      return isAdmin() || 
        (minRole == 'basic' && (getUserRole() == 'basic' || getUserRole() == 'premium')) ||
        (minRole == 'premium' && getUserRole() == 'premium');
    }

    // Coleção de Usuários (Perfil do Responsável)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Regras de Papéis e Direitos (Apenas backend/Admin pode alterar)
    match /user_roles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /entitlements/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // Compras e Eventos de Pagamento
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /payment_events/{eventId} {
      allow read, write: if isAdmin();
    }

    // Catálogo de Receitas
    match /recipes/{recipeId} {
      allow read: if isAuthenticated() && (
        resource.data.tier == 'basic' ? hasEntitlement('basic') : hasEntitlement('premium')
      );
      allow write: if isAdmin();
    }

    // Tags e Categorias
    match /tags/{tagId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Favoritos do Usuário (Isolados por UID)
    match /favorites/{userId} {
      allow read, write: if isOwner(userId) && hasEntitlement('premium');
    }

    // Planejamento Semanal (Isolado por UID)
    match /meal_plans/{userId} {
      allow read, write: if isOwner(userId) && hasEntitlement('premium');
      
      match /weeks/{weekId} {
        allow read, write: if isOwner(userId) && hasEntitlement('premium');
      }
    }

    // Lista de Compras (Isolada por UID)
    match /shopping_lists/{userId} {
      allow read, write: if isOwner(userId) && hasEntitlement('premium');
    }

    // Materiais Digitais e E-books (Metadados)
    match /content_assets/{assetId} {
      allow read: if isAuthenticated() && (
        resource.data.requiredTier == 'basic' ? hasEntitlement('basic') : hasEntitlement('premium')
      );
      allow write: if isAdmin();
    }

    // Central de Dúvidas e Artigos
    match /support_articles/{articleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Chamados de Suporte
    match /support_requests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Preferências de Notificação e Lembretes
    match /notification_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Logs de Auditoria (Apenas Admin / Servidor)
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
